<?xml version="1.0"?>
<!--
  Browser model derived only from the Onshape assembly_1 URDF export.
  Every visible mesh comes from that export; no probe or generated primitive
  geometry is included.
-->
<robot name="ruggedized_wrist_onshape">
  <material name="imported_motor">
    <color rgba="0.91 0.91 0.91 1"/>
  </material>
  <material name="base_finish">
    <color rgba="0.501961 0.486275 0.439216 1"/>
  </material>
  <material name="machined_finish">
    <color rgba="0.901961 0.878431 0.811765 1"/>
  </material>
  <material name="pulley_finish">
    <color rgba="0.917647 0.917647 0.917647 1"/>
  </material>
  <material name="gecko_finish">
    <color rgba="0.35 0.43 0.31 1"/>
  </material>

  <link name="root"/>

  <link name="wrist_base">
    <visual>
      <geometry>
        <mesh filename="meshes/base.glb?v=20260731-j9-gecko-2"/>
      </geometry>
      <material name="base_finish"/>
    </visual>
  </link>

  <joint name="root_to_base" type="fixed">
    <parent link="root"/>
    <child link="wrist_base"/>
    <origin xyz="0 -0.00025 0.04545"/>
  </joint>

  <link name="mount_to_arm">
    <visual>
      <origin xyz="0 -0.00025 0.0298"/>
      <geometry>
        <mesh filename="meshes/mount-to-arm.glb?v=20260731-j9-gecko-2"/>
      </geometry>
      <material name="machined_finish"/>
    </visual>
  </link>

  <joint name="base_to_mount" type="fixed">
    <parent link="wrist_base"/>
    <child link="mount_to_arm"/>
    <origin xyz="0 0.00025 -0.0298"/>
  </joint>

  <link name="pitch_motor">
    <visual>
      <origin xyz="-0.0223882 -0.033 -0.0159693"/>
      <geometry>
        <mesh filename="meshes/pitch-motor.glb?v=20260731-j9-gecko-2"/>
      </geometry>
      <material name="imported_motor"/>
    </visual>
  </link>

  <joint name="base_to_pitch_motor" type="fixed">
    <parent link="wrist_base"/>
    <child link="pitch_motor"/>
    <origin xyz="0.0223882 0.0334 0.0159693"/>
  </joint>

  <link name="pitch_pulley_connector">
    <visual>
      <origin xyz="0 0.0141 0" rpy="0 -0.0947442 0"/>
      <geometry>
        <mesh filename="meshes/pitch-pulley-connector.glb?v=20260731-j9-gecko-2"/>
      </geometry>
      <material name="machined_finish"/>
    </visual>
  </link>

  <joint name="pitch_drive_fixed" type="fixed">
    <parent link="pitch_motor"/>
    <child link="pitch_pulley_connector"/>
    <origin xyz="-0.0223882 -0.0471 -0.0159693"/>
  </joint>

  <link name="pitch_pulley">
    <visual>
      <origin xyz="0 0.024 0"/>
      <geometry>
        <mesh filename="meshes/pitch-pulley.glb?v=20260731-j9-gecko-2"/>
      </geometry>
      <material name="pulley_finish"/>
    </visual>
  </link>

  <joint name="connector_to_pulley" type="fixed">
    <parent link="pitch_pulley_connector"/>
    <child link="pitch_pulley"/>
    <origin xyz="0 -0.0099 0" rpy="0 -0.0947442 0"/>
  </joint>

  <!-- J8 uses the exported pitch-axis mate and its original CAD bracket. -->
  <link name="roll_motor_bracket">
    <visual>
      <origin xyz="0.00572345 -0.032 -0.0602287"
              rpy="0 -0.0947442 0"/>
      <geometry>
        <mesh filename="meshes/roll-motor-bracket.glb?v=20260731-j9-gecko-2"/>
      </geometry>
      <material name="machined_finish"/>
    </visual>
  </link>

  <joint name="wrist_pitch_joint" type="revolute">
    <parent link="wrist_base"/>
    <child link="roll_motor_bracket"/>
    <origin xyz="0 0.0324 0.0605"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.570796" upper="1.570796"
           effort="12" velocity="2"/>
  </joint>

  <link name="roll_motor_housing">
    <visual>
      <origin xyz="-0.0192142 -0.0143099 -0.03755"/>
      <geometry>
        <mesh filename="meshes/roll-motor-housing.glb?v=20260731-j9-gecko-2"/>
      </geometry>
      <material name="imported_motor"/>
    </visual>
  </link>

  <joint name="bracket_to_roll_motor" type="fixed">
    <parent link="roll_motor_bracket"/>
    <child link="roll_motor_housing"/>
    <origin xyz="0.0212802 -0.0176901 -0.0208303"
            rpy="0 -0.0947442 0"/>
  </joint>

  <!--
    J9 rotates only the central cylindrical output from the Onshape roll motor.
    The surrounding square housing remains fixed.
    The visual offset exactly cancels the joint offset at zero angle, so the
    neutral pose matches the exported assembly.
  -->
  <link name="roll_output">
    <visual>
      <origin xyz="0 -0.00035 -0.06985"/>
      <geometry>
        <mesh filename="meshes/roll-output.glb?v=20260731-j9-gecko-2"/>
      </geometry>
      <material name="imported_motor"/>
    </visual>
  </link>

  <joint name="wrist_roll_joint" type="revolute">
    <parent link="roll_motor_housing"/>
    <child link="roll_output"/>
    <origin xyz="-0.0192142 -0.0139599 0.0323"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141593" upper="3.141593"
           effort="12" velocity="2"/>
  </joint>

  <!-- Supplied Gecko attachment, centered on J9 with its front facing +Z. -->
  <link name="gecko_attachment">
    <visual>
      <origin xyz="-0.010232 0.000357 0"/>
      <geometry>
        <mesh filename="meshes/gecko.glb?v=20260731-j9-gecko-2"
              scale="0.00045 0.00045 0.00045"/>
      </geometry>
      <material name="gecko_finish"/>
    </visual>
  </link>

  <joint name="roll_output_to_gecko" type="fixed">
    <parent link="roll_output"/>
    <child link="gecko_attachment"/>
    <origin xyz="0 0 0.0087"/>
  </joint>
</robot>
