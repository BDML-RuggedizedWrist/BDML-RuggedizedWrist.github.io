<?xml version="1.0"?>
<robot name="ruggedized_wrist_web">
  <material name="frame_dark">
    <color rgba="0.20 0.22 0.24 1"/>
  </material>
  <material name="housing_light">
    <color rgba="0.82 0.80 0.74 1"/>
  </material>
  <material name="motor_blue">
    <color rgba="0.32 0.55 0.66 1"/>
  </material>
  <material name="metal">
    <color rgba="0.72 0.74 0.76 1"/>
  </material>
  <material name="probe">
    <color rgba="0.86 0.87 0.89 1"/>
  </material>

  <!-- Fixed interface and external frame. -->
  <link name="wrist_base">
    <visual>
      <geometry>
        <mesh filename="meshes/wrist-base.stl"/>
      </geometry>
      <material name="frame_dark"/>
    </visual>
    <visual>
      <origin xyz="0 -0.002 0.020"/>
      <geometry>
        <box size="0.056 0.060 0.050"/>
      </geometry>
      <material name="motor_blue"/>
    </visual>
    <visual>
      <origin xyz="0 0.030 0.020" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.058"/>
      </geometry>
      <material name="motor_blue"/>
    </visual>
  </link>

  <link name="wrist_mount">
    <visual>
      <origin xyz="0 -0.00025 0.0298"/>
      <geometry>
        <mesh filename="meshes/wrist-mount.stl"/>
      </geometry>
      <material name="housing_light"/>
    </visual>
  </link>

  <joint name="base_to_mount" type="fixed">
    <parent link="wrist_base"/>
    <child link="wrist_mount"/>
    <origin xyz="0 0.00025 -0.0298"/>
  </joint>

  <link name="pitch_drive">
    <visual>
      <origin xyz="0 0.024 0"/>
      <geometry>
        <mesh filename="meshes/pitch-pulley.stl"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="0 0.0141 0" rpy="0 -0.094744 0"/>
      <geometry>
        <mesh filename="meshes/pitch-pulley-connector.stl"/>
      </geometry>
      <material name="housing_light"/>
    </visual>
  </link>

  <joint name="base_to_pitch_drive" type="fixed">
    <parent link="wrist_base"/>
    <child link="pitch_drive"/>
    <origin xyz="0.022388 0.0334 0.015969"/>
  </joint>

  <!-- J8: wrist pitch about local Y. -->
  <link name="wrist_pitch_link">
    <visual>
      <origin xyz="0.005723 -0.032 -0.060229" rpy="0 -0.094744 0"/>
      <geometry>
        <mesh filename="meshes/pitch-bracket.stl"/>
      </geometry>
      <material name="housing_light"/>
    </visual>
    <visual>
      <origin xyz="0 -0.012 -0.006" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.023" length="0.052"/>
      </geometry>
      <material name="motor_blue"/>
    </visual>
    <visual>
      <origin xyz="-0.019214 -0.014310 -0.037550"/>
      <geometry><mesh filename="meshes/roll-motor-1.stl"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="-0.019214 -0.014310 -0.037550"/>
      <geometry><mesh filename="meshes/roll-motor-2.stl"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="-0.019214 -0.014310 -0.037550"/>
      <geometry><mesh filename="meshes/roll-motor-3.stl"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="-0.019214 -0.014310 -0.037550"/>
      <geometry><mesh filename="meshes/roll-motor-4.stl"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="-0.019214 -0.014310 -0.037550"/>
      <geometry><mesh filename="meshes/roll-motor-5.stl"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="-0.019214 -0.014310 -0.037550"/>
      <geometry><mesh filename="meshes/roll-motor-6.stl"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="-0.019214 -0.014310 -0.037550"/>
      <geometry><mesh filename="meshes/roll-motor-7.stl"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="-0.019214 -0.014310 -0.037550"/>
      <geometry><mesh filename="meshes/roll-motor-8.stl"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="-0.019214 -0.014310 -0.037550"/>
      <geometry><mesh filename="meshes/roll-motor-9.stl"/></geometry>
      <material name="metal"/>
    </visual>
  </link>

  <joint name="wrist_pitch_joint" type="revolute">
    <parent link="wrist_base"/>
    <child link="wrist_pitch_link"/>
    <origin xyz="0 0.0324 0.0605"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.570796" upper="1.570796" effort="12" velocity="2"/>
  </joint>

  <!-- J9: centered terminal roll about local Z. -->
  <link name="probe_roll_output">
    <visual>
      <geometry>
        <cylinder radius="0.025" length="0.010"/>
      </geometry>
      <material name="frame_dark"/>
    </visual>
    <visual>
      <origin xyz="0.017 0 0.006"/>
      <geometry>
        <box size="0.034 0.010 0.006"/>
      </geometry>
      <material name="housing_light"/>
    </visual>
  </link>

  <joint name="wrist_roll_joint" type="revolute">
    <parent link="wrist_pitch_link"/>
    <child link="probe_roll_output"/>
    <origin xyz="-0.001159 -0.031650 0.012195" rpy="3.141593 -0.094744 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141593" upper="3.141593" effort="12" velocity="2"/>
  </joint>

  <link name="linear_probe">
    <visual>
      <origin xyz="-0.03323 -0.01336 -0.13254"/>
      <geometry>
        <mesh filename="meshes/linear-transducer.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="probe"/>
    </visual>
  </link>

  <joint name="roll_output_to_probe" type="fixed">
    <parent link="probe_roll_output"/>
    <child link="linear_probe"/>
    <origin xyz="0 0 0" rpy="3.141593 0 0"/>
  </joint>
</robot>
